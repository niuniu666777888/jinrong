# Copy to .env and fill in the values you need. Never commit a real .env.

# LLM: mock works without a key; openai/deepseek need base URL + key + model.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Embedding: hash is the offline fallback; openai points to any /embeddings API.
EMB_PROVIDER=hash
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL=
EMB_DIM=512

# Retrieval / storage
DOCS_DIR=./docs
DB_PATH=./app.db
TOP_K=3
HISTORY_TURNS=6
MAX_MESSAGES=200
MIN_SCORE=0.30

# Web security
JWT_SECRET=

# First-run accounts (leave blank to print random passwords once)
ADMIN_INIT_PASSWORD=
EMPLOYEE_INIT_PASSWORD=
